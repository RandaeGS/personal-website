<style>
	.section-nav {
		position: fixed;
		bottom: 16px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		gap: 4px;
		padding: 6px;
		background-color: rgba(17, 24, 39, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		backdrop-filter: blur(8px);
		z-index: 100;
	}

	.section-nav a {
		position: relative;
		display: grid;
		place-items: center;
		padding: 8px;
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
	}

	.section-nav a::after {
		content: attr(data-label);
		position: absolute;
		bottom: calc(100% + 10px);
		left: 50%;
		transform: translateX(-50%);
		padding: 4px 8px;
		border-radius: 6px;
		background-color: rgba(17, 24, 39, 0.9);
		border: 1px solid rgba(255, 255, 255, 0.12);
		color: #ffffff;
		font-size: 0.75rem;
		white-space: nowrap;
		text-decoration: none;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
	}

	.section-nav a:hover::after,
	.section-nav a:focus-visible::after {
		opacity: 1;
	}

	.section-nav a:hover,
	.section-nav a:focus-visible {
		color: #ffffff;
		background-color: rgba(255, 255, 255, 0.12);
	}

	.section-nav a:focus-visible {
		outline: none;
	}
</style>
